cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/leo/anaconda3/envs/gaussian_splatting_24_04/include -fPIC -O2 -isystem /home/leo/anaconda3/envs/gaussian_splatting_24_04/include -march=nocona -mtune=haswell -ftree-vectorize -fPIC -fstack-protector-strong -fno-plt -O2 -ffunction-sections -pipe -isystem /home/leo/anaconda3/envs/gaussian_splatting_24_04/include -DNDEBUG -D_FORTIFY_SOURCE=2 -O2 -isystem /home/leo/anaconda3/envs/gaussian_splatting_24_04/include -fPIC -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/TH -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-12.4/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++17
cuda_cflags = -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/TH -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/lib/python3.8/site-packages/torch/include/THC -I/usr/local/cuda-12.4/include -I/home/leo/anaconda3/envs/gaussian_splatting_24_04/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_75,code=compute_75 -gencode=arch=compute_75,code=sm_75 -ccbin /home/leo/anaconda3/envs/gaussian_splatting_24_04/bin/x86_64-conda-linux-gnu-cc -std=c++17
cuda_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags





